# DEVELOPMENT .ENV
NEXT_PUBLIC_APP_VERSION=1.0.0

# FRONTEND
URL_PREFIX="http"
URL="localhost"
PORT=3000
NEXT_PUBLIC_PATH="${URL_PREFIX}://${URL}:${PORT}"
NEXT_PUBLIC_API_PATH="${NEXT_PUBLIC_PATH}/api"

# Эта секция продублирована из package/database
# POSTGRES
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DATABASE="promka_dev"
POSTGRES_SCHEMA="public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="123456"

# Эта секция продублирована из package/database
# PRISMA
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}?schema=${POSTGRES_SCHEMA}"

# JOSE
AUTH_SECRET="secret"
ACCESS_TOKEN_SECRET="secret"
REFRESH_TOKEN_SECRET="secret"
# 10 часов
ACCESS_TOKEN_LIVE="10h"
ACCESS_TOKEN_LIVE_NUMBER=36000000
#ACCESS_TOKEN_LIVE="10s" # для теста обновления
#ACCESS_TOKEN_LIVE_NUMBER=10000
# 30 дней
REFRESH_TOKEN_LIVE="30d"
REFRESH_TOKEN_LIVE_NUMBER=2592000000
#REFRESH_TOKEN_LIVE="15s"
#REFRESH_TOKEN_LIVE_NUMBER=15000

# Приложение
# Приватный URL для авторизованного пользователя по умолчанию
NEXT_PUBLIC_DEFAULT_PRIVATE_URL="/dashboard"

