{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      // Модули
      "@/Workspaces": ["./app/(private)/(workspaces)/index.ts"],
      "@/Workspaces/*": ["./app/(private)/(workspaces)/*"],
      "@/WorkspacePermissions": [
        "./app/(private)/(workspace-permissions)/index.ts"
      ],
      "@/WorkspacePermissions/*": ["./app/(private)/(workspace-permissions)/*"],
      "@/TeamMember": ["./app/(private)/(team-members)/index.ts"],
      "@/TeamMember/*": ["./app/(private)/(team-members)/*"],
      "@/Companies": ["./app/(private)/(companies)/index.ts"],
      "@/Companies/*": ["./app/(private)/(companies)/*"],
      "@/Users": ["./app/(private)/(users)/index.ts"],
      "@/Users/*": ["./app/(private)/(users)/*"],
      "@/Files": ["./app/(private)/(files)/index.ts"],
      "@/Files/*": ["./app/(private)/(files)/*"],
      "@/Employees": ["./app/(private)/(employees)/index.ts"],
      "@/Employees/*": ["./app/(private)/(employees)/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
