{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      // Модули
      "@/Workspaces": ["./app/(private)/(workspaces)/index.ts"],
      "@/Workspaces/*": ["./app/(private)/(workspaces)/*"],
      "@/WorkspacePermissions": [
        "./app/(private)/(workspace-permissions)/index.ts"
      ],
      "@/WorkspacePermissions/*": ["./app/(private)/(workspace-permissions)/*"],
      "@/TeamMember": ["./app/(private)/(team-members)/index.ts"],
      "@/TeamMember/*": ["./app/(private)/(team-members)/*"],
      "@/Companies": ["./app/(private)/(companies)/index.ts"],
      "@/Companies/*": ["./app/(private)/(companies)/*"],
      "@/Users": ["./app/(private)/(users)/index.ts"],
      "@/Users/*": ["./app/(private)/(users)/*"],
      "@/Files": ["./app/(private)/(files)/index.ts"],
      "@/Files/*": ["./app/(private)/(files)/*"],
      "@/Employees": ["./app/(private)/(employees)/index.ts"],
      "@/Employees/*": ["./app/(private)/(employees)/*"],
      "@/Berthes": ["./app/(private)/(berthes)/index.ts"],
      "@/Berthes/*": ["./app/(private)/(berthes)/*"],
      "@/BerthTypes": ["./app/(private)/(berth-types)/index.ts"],
      "@/BerthTypes/*": ["./app/(private)/(berth-types)/*"],
      "@/Departments": ["./app/(private)/(departments)/index.ts"],
      "@/Departments/*": ["./app/(private)/(departments)/*"],
      "@/Specializations": ["./app/(private)/(specializations)/index.ts"],
      "@/Specializations/*": ["./app/(private)/(specializations)/*"],
      "@/SpecializationDirections": [
        "./app/(private)/(specialization-directions)/index.ts"
      ],
      "@/SpecializationDirections/*": [
        "./app/(private)/(specialization-directions)/*"
      ],
      "@/SpecializationParameters": [
        "./app/(private)/(specialization-parameters)/index.ts"
      ],
      "@/SpecializationParameters/*": [
        "./app/(private)/(specialization-parameters)/*"
      ],
      "@/Certificates": ["./app/(private)/(certificates)/index.ts"],
      "@/Certificates/*": ["./app/(private)/(certificates)/*"],
      "@/Protocols": ["./app/(private)/(protocols)/index.ts"],
      "@/Protocols/*": ["./app/(private)/(protocols)/*"],
      "@/StudyOrganizations": [
        "./app/(private)/(study-organizations)/index.ts"
      ],
      "@/StudyOrganizations/*": ["./app/(private)/(study-organizations)/*"],
      "@/Studies": ["./app/(private)/(studies)/index.ts"],
      "@/Studies/*": ["./app/(private)/(studies)/*"],
      "@/Passports": ["./app/(private)/(passports)/index.ts"],
      "@/Passports/*": ["./app/(passports)/(passports)/*"],
      "@/Snilses": ["./app/(private)/(snilses)/index.ts"],
      "@/Snilses/*": ["./app/(snilses)/(snilses)/*"],
      "@/Diplomas": ["./app/(private)/(diplomas)/index.ts"],
      "@/Diplomas/*": ["./app/(snilses)/(diplomas)/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
