{
  "name": "@workspace/database",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "dev:docker:compose:up": "docker compose -f docker/development/compose.yaml --env-file .env.development up -d",
    "dev:docker:compose:build": "docker compose -f docker/development/compose.yaml --env-file .env.development build",
    "dev:db:client:generate": "dotenv -e .env.development -- npm exec prisma generate --schema",
    "dev:db:push": "npm run dev:db:client:generate && dotenv -e .env.development -- npm exec prisma db push",
    "dev:db:seed": "dotenv -e .env.development -- npx prisma db seed"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/language-server": "^7.0.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0"
  }
}
