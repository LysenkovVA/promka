/**
 * Сотрудник
 */
model Employee {
  id          String    @id @default(cuid())
  // URL аватара
  avatar      File?     @relation(name: "employee-avatar")
  // Фамилия
  surname     String
  // Имя
  name        String?
  // Отчество
  patronymic  String?
  // Дата рождения
  birthDate   DateTime?
  // Дата приема на работу
  hireDate    DateTime?
  // Дата увольнения
  firedDate   DateTime?
  // СНИЛС
  // TODO не надо
  snils       String?
  // Номер телефона
  phoneNumber String?
  // Электронная почта
  email       String?

  berth   Berth?  @relation(name: "berth-employees", fields: [berthId], references: [id], onDelete: SetNull)
  berthId String?

  department   Department? @relation(name: "department-employees", fields: [departmentId], references: [id], onDelete: Restrict)
  departmentId String?

  studies Study[] @relation(name: "studies-employees")

  certificates Certificate[] @relation(name: "employee-certificates")

  passports Passport[] @relation(name: "employee-passports")

  snilses Snils[] @relation(name: "employee-snilses")

  diplomas Diploma[] @relation(name: "employee-diplomas")

  // Гражданство
  citizenship   Citizenship? @relation(name: "citizenship-employees", fields: [citizenshipId], references: [id], onDelete: Cascade)
  citizenshipId String?

  // Рабочее пространство
  workspace   Workspace @relation(name: "workspace-employees", fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([surname, name])
  @@map("employees")
}
