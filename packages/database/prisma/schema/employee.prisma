/**
 * Сотрудник
 */
model Employee {
  id         String    @id @default(cuid())
  // Фамилия
  surname    String
  // Имя
  name       String?
  // Отчество
  patronymic String?
  // Дата рождения
  birthDate  DateTime?

  // Дата приема на работу
  hireDate    DateTime?
  // Дата увольнения
  firedDate   DateTime?
  // СНИЛС
  snils       String?
  // Номер телефона
  phoneNumber String?
  // Электронная почта
  email       String?

  berth   Berth?  @relation(name: "berth-employees", fields: [berthId], references: [id], onDelete: SetNull)
  berthId String?

  department   Department? @relation(name: "department-employees", fields: [departmentId], references: [id], onDelete: Restrict)
  departmentId String?

  // Рабочее пространство
  workspace   Workspace? @relation(name: "workspace-employees", fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String?

  @@index([surname, name])
  @@map("employees")
}
