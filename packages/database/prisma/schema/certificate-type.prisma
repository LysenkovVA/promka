/**
 * Тип удостоверения
 */
model CertificateType {
  id               String  @id @default(cuid())
  name             String
  hasGroups        Boolean @default(false)
  // 0 - Безлимитно
  durationAtMonths Int     @default(0)

  // Рабочее пространство
  workspace   Workspace? @relation(name: "workspace-certificate-types", fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String?

  certificates Certificate[] @relation("certificate-type-certificates")

  // Пользователь
  user   User?   @relation(name: "user-certificate-types", fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  @@index([name])
  @@map("certificate-types")
}
