/**
 * Рабочее пространство
 * Эта сущность отвечает за связь пользователей и компаний
 */
model Workspace {
  id String @id @default(cuid())

  // Компания
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String  @unique

  // Участники рабочего пространства
  teamMembers TeamMember[] @relation(name: "workspace-team-members")

  // Сотрудники компании
  employees   Employee[]   @relation(name: "workspace-employees")
  // Должности компании
  berthes     Berth[]      @relation(name: "workspace-berthes")
  // Типы должностей компании
  berthTypes  BerthType[]  @relation(name: "workspace-berth-types")
  // Подразделения
  departments Department[] @relation(name: "workspace-departments")

  @@map("workspaces")
}
