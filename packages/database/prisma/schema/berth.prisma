/**
 * Должность сотрудника
 */
model Berth {
  id   String @id @default(cuid())
  name String

  // Рабочее пространство
  workspace   Workspace @relation(name: "workspace-berthes", fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  berthType   BerthType @relation(name: "berth-type-berthes", fields: [berthTypeId], references: [id], onDelete: Restrict)
  berthTypeId String

  employees Employee[] @relation(name: "berth-employees")

  @@index([name])
  @@map("berthes")
}
