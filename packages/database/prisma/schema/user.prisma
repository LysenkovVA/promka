model User {
  id                   String    @id @default(cuid())
  // Email
  email                String
  // Хешированный пароль
  hashedPassword       String
  // Номер телефона
  phoneNumber          String?
  // Признак того, что email подтвержден
  emailConfirmed       Boolean   @default(false)
  // Признак того, что телефон подтвержден
  phoneNumberConfirmed Boolean   @default(false)
  // Фамилия
  surname              String?
  // Имя
  name                 String?
  patronymic           String?
  // Дата рождения
  birthDate            DateTime?
  // URL аватара
  avatar               File?     @relation(name: "user-avatar")
  // Роль
  userRole             UserRole  @default(USER)

  refreshTokens RefreshToken[] @relation(name: "user-refreshTokens")

  teamMembers TeamMember[] @relation(name: "user-team-members")

  @@index([email])
  @@map("users")
}

/**
 * Роли пользователей приложения
 */
enum UserRole {
  // Администратор
  ADMINISTRATOR
  // Пользователь
  USER
}
