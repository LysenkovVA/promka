/**
 * Удостоверение
 */
model Certificate {
  id     String   @id @default(cuid())
  number String
  date   DateTime
  group  String?

  // Рабочее пространство
  workspace   Workspace? @relation(name: "workspace-certificates", fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String?

  // Пользователь
  user   User?   @relation(name: "user-certificates", fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  // Тип удостоверения
  certificateType   CertificateType @relation(name: "certificate-type-certificates", fields: [certificateTypeId], references: [id], onDelete: Restrict)
  certificateTypeId String

  // Сотрудник
  employee   Employee? @relation(name: "employee-certificates", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String?

  // Копии
  files File[] @relation(name: "certificate-files")

  // Протокол
  protocol   Protocol? @relation(name: "protocol-certificates", fields: [protocolId], references: [id], onDelete: SetNull)
  protocolId String?

  @@index([number])
  @@map("certificates")
}
