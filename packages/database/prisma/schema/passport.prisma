/**
 * Паспорт
 */
model Passport {
  id String @id @default(cuid())

  // Серия
  series              String
  // Номер
  number              String
  // Дата рождения
  birthDate           DateTime?
  // Место рождения
  birthPlace          String?
  // Выдан
  issuedBy            String?
  // Код подразделения
  subdivisionCode     String?
  // Дата выдачи
  issueDate           DateTime?
  // Адрес регистрации
  registrationAddress String?

  // Сотрудник
  employee   Employee @relation(name: "employee-passports", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  // Рабочее пространство
  workspace   Workspace @relation(name: "workspace-passports", fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([series, number])
  @@map("passports")
}
