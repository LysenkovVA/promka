/**
 * Тип должности сотрудника
 */
model BerthType {
  id   String @id @default(cuid())
  name String

  // Рабочее пространство
  workspace   Workspace @relation(name: "workspace-berth-types", fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  berthes Berth[] @relation("berth-type-berthes")

  @@index([name])
  @@map("berth-types")
}
