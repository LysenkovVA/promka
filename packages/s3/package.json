{
  "name": "@workspace/s3",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "dev:docker:compose:up": "docker compose -f docker/development/compose.yaml --env-file .env.development up -d",
    "dev:docker:compose:build": "docker compose -f docker/development/compose.yaml --env-file .env.development build"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "minio": "^8.0.7"
  }
}
